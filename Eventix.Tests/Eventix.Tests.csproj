<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ApiTests\**" />
    <Compile Remove="IntegrationTests\**" />
    <Compile Remove="UnitTests\**" />
    <EmbeddedResource Remove="ApiTests\**" />
    <EmbeddedResource Remove="IntegrationTests\**" />
    <EmbeddedResource Remove="UnitTests\**" />
    <None Remove="ApiTests\**" />
    <None Remove="IntegrationTests\**" />
    <None Remove="UnitTests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eventix.Api\Eventix.Api.csproj" />
    <ProjectReference Include="..\Eventix.Application\Eventix.Application.csproj" />
    <ProjectReference Include="..\Eventix.Domain\Eventix.Domain.csproj" />
    <ProjectReference Include="..\Eventix.Infrastructure\Eventix.Infrastructure.csproj" />
  </ItemGroup>

</Project>
